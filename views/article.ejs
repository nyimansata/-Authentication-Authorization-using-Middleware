<!DOCTYPE html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Article</title>
    <link rel="stylesheet" href="/styles/article.css" />
  </head>

  <body>
    <h1>Articles</h1>

    <div class="container">
      <% articleData.forEach(item => { %>
      <div class="items">
        <h4><%= item.title %></h4>
        <p><%= item.content %></p>
      </div>
      <% }) %>
    </div>
  </body>
</html>
